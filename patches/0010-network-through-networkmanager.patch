@@ -0,0 +1,39 @@
+#pragma once
+
+#if defined(HAVE_NETWORKMANAGER)
+
+#include "GuiComponent.h"
+#include "NetworkManagerClient.h"
+#include "components/MenuComponent.h"
+
+#include <functional>
+#include <string>
+#include <vector>
+
+// List of the Wi-Fi networks in range: join one (asking for the password when it needs
+// one), disconnect from it or forget it. Talks to NetworkManager directly.
+class GuiNetworkWifi : public GuiComponent
+{
+public:
+	// onChanged is called after something changed (joined, disconnected, forgotten).
+	GuiNetworkWifi(Window* window, const std::function<void()>& onChanged);
+
+	bool input(InputConfig* config, Input input) override;
+	std::vector<HelpPrompt> getHelpPrompts() override;
+
+private:
+	void load(const std::vector<NetworkManager::AccessPoint>& networks);
+	void onRefresh();
+	void onSelect(const NetworkManager::AccessPoint& network);
+	void askPassword(const std::string& ssid);
+	void connect(const std::string& ssid, const std::string& key);
+	void disconnect();
+	void forget(const std::string& ssid);
+	void finished(bool ok, const std::string& failureText, const std::string& error);
+
+	MenuComponent mMenu;
+	std::function<void()> mOnChanged;
+	bool mWaitingLoad;
+};
+
+#endif
