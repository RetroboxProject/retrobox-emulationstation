+#pragma once
+
+#if defined(HAVE_NETWORKMANAGER)
+
+#include "guis/GuiSettings.h"
+
+// NETWORK SETTINGS on a desktop Linux: Wi-Fi (radio, current network, list of networks)
+// and Ethernet (status, connect/disconnect), all through NetworkManager.
+class GuiNetworkSettings : public GuiSettings
+{
+public:
+	// autoSel: row to leave the cursor on when the screen is rebuilt (0 = first)
+	GuiNetworkSettings(Window* window, int autoSel = 0);
+
+private:
+	void reopen(int autoSel);
+	void runEthernet(const std::string& devicePath, bool connect, int autoSel);
+};
+
+#endif
diff --git a/es-app/src/guis/GuiNetworkWifi.cpp b/es-app/src/guis/GuiNetworkWifi.cpp
new file mode 100644
index 0000000..dba1de4
--- /dev/null
+++ b/es-app/src/guis/GuiNetworkWifi.cpp
@@ -0,0 +1,248 @@
+#if defined(HAVE_NETWORKMANAGER)
+
+#include "guis/GuiNetworkWifi.h"
+
+#include "GuiLoading.h"
+#include "LocaleES.h"
+#include "Log.h"
+#include "Settings.h"
+#include "Window.h"
+#include "guis/GuiMsgBox.h"
+#include "guis/GuiTextEditPopup.h"
+#include "guis/GuiTextEditPopupKeyboard.h"
+#include "utils/StringUtil.h"
+
+#include <utility>
+
+namespace
+{
+	typedef std::pair<bool, std::string> Result;   // success, error text
+}
+
+GuiNetworkWifi::GuiNetworkWifi(Window* window, const std::function<void()>& onChanged)
+	: GuiComponent(window), mMenu(window, _("WI-FI NETWORKS").c_str()), mOnChanged(onChanged), mWaitingLoad(false)
+{
+	addChild(&mMenu);
+
+	mMenu.addButton(_("REFRESH"), "refresh", [this] { onRefresh(); });
+	mMenu.addButton(_("BACK"), "back", [this] { delete this; });
+
+	load(NetworkManager::accessPoints(false));
+
+	// A fresh scan right away: what NetworkManager has cached may be old.
+	mWindow->postToUiThread([this]() { onRefresh(); });
+
+	if (Renderer::ScreenSettings::fullScreenMenus())
+		mMenu.setPosition((Renderer::getScreenWidth() - mMenu.getSize().x()) / 2, (Renderer::getScreenHeight() - mMenu.getSize().y()) / 2);
+	else
+		mMenu.setPosition((Renderer::getScreenWidth() - mMenu.getSize().x()) / 2, Renderer::getScreenHeight() * 0.15f);
+}
+
+void GuiNetworkWifi::load(const std::vector<NetworkManager::AccessPoint>& networks)
+{
+	const bool stayOnButtons = mMenu.isCursorToButtons();
+
+	mMenu.clear();
+
+	if (networks.empty())
+		mMenu.addEntry(_("NO WI-FI NETWORKS FOUND"), false, [this] { onRefresh(); });
+	else
+	{
+		for (const auto& network : networks)
+		{
+			std::string name = network.ssid;
+			if (network.connected)
+				name += " (" + _("CONNECTED") + ")";
+
+			std::string description = _("SIGNAL") + " " + std::to_string(network.strength) + "%";
+			if (network.secured)
+				description += " - " + _("SECURED");
+			if (network.saved)
+				description += " - " + _("SAVED");
+			if (!network.supported)
+				description += " - " + _("NOT SUPPORTED");
+
+			mMenu.addWithDescription(name, description, nullptr, [this, network] { onSelect(network); });
+		}
+	}
+
+	mMenu.updateSize();
+
+	if (stayOnButtons)
+		mMenu.setCursorToButtons();
+	else
+		mMenu.setCursorToList();
+
+	if (Renderer::ScreenSettings::fullScreenMenus())
+		mMenu.setPosition((Renderer::getScreenWidth() - mMenu.getSize().x()) / 2, (Renderer::getScreenHeight() - mMenu.getSize().y()) / 2);
+
+	mWaitingLoad = false;
+}
+
+void GuiNetworkWifi::onRefresh()
+{
+	if (mWaitingLoad)
+		return;
+
+	mWaitingLoad = true;
+
+	mWindow->pushGui(new GuiLoading<std::vector<NetworkManager::AccessPoint>>(mWindow, _("SEARCHING WI-FI NETWORKS"),
+		[](auto gui)
+		{
+			return NetworkManager::accessPoints(true);
+		},
+		[this](std::vector<NetworkManager::AccessPoint> networks)
+		{
+			load(networks);
+		}));
+}
+
+void GuiNetworkWifi::onSelect(const NetworkManager::AccessPoint& network)
+{
+	if (mWaitingLoad)
+		return;
+
+	Window* window = mWindow;
+	const std::string ssid = network.ssid;
+
+	if (network.connected || network.saved)
+	{
+		// Joined or known already: no password to ask.
+		window->pushGui(new GuiMsgBox(window, ssid,
+			network.connected ? _("DISCONNECT") : _("CONNECT"),
+			[this, ssid, connected = network.connected] { if (connected) disconnect(); else connect(ssid, ""); },
+			_("FORGET"), [this, ssid] { forget(ssid); },
+			_("BACK"), nullptr));
+	}
+	else if (!network.supported)
+	{
+		window->pushGui(new GuiMsgBox(window, _("THIS NETWORK USES WEP OR WPA-ENTERPRISE, WHICH CANNOT BE SET UP HERE.")));
+	}
+	else if (network.secured)
+		askPassword(ssid);
+	else
+		connect(ssid, "");
+}
+
+void GuiNetworkWifi::askPassword(const std::string& ssid)
+{
+	const std::string title = _("WI-FI KEY");
+	auto onKey = [this, ssid](const std::string& key)
+	{
+		if (!key.empty())
+			connect(ssid, key);
+	};
+
+	if (Settings::getInstance()->getBool("UseOSK"))
+		mWindow->pushGui(new GuiTextEditPopupKeyboard(mWindow, title, "", onKey, false));
+	else
+		mWindow->pushGui(new GuiTextEditPopup(mWindow, title, "", onKey, false));
+}
+
+void GuiNetworkWifi::connect(const std::string& ssid, const std::string& key)
+{
+	if (mWaitingLoad)
+		return;
+
+	mWaitingLoad = true;
+
+	mWindow->pushGui(new GuiLoading<Result>(mWindow, Utils::String::format(_("CONNECTING TO %s").c_str(), ssid.c_str()),
+		[ssid, key](auto gui)
+		{
+			std::string error;
+			bool ok = NetworkManager::connectWifi(ssid, key, &error);
+			if (!ok)
+			{
+				LOG(LogError) << "Wi-Fi: connecting to " << ssid << " failed: " << error;
+			}
+
+			return Result(ok, error);
+		},
+		[this, ssid](Result result)
+		{
+			finished(result.first, Utils::String::format(_("COULD NOT CONNECT TO '%s'.").c_str(), ssid.c_str()), result.second);
+		}));
+}
+
+void GuiNetworkWifi::disconnect()
+{
+	if (mWaitingLoad)
+		return;
+
+	mWaitingLoad = true;
+
+	mWindow->pushGui(new GuiLoading<Result>(mWindow, _("PLEASE WAIT"),
+		[](auto gui)
+		{
+			std::string error;
+			bool ok = NetworkManager::disconnectWifi(&error);
+			return Result(ok, error);
+		},
+		[this](Result result)
+		{
+			finished(result.first, _("COULD NOT DISCONNECT."), result.second);
+		}));
+}
+
+void GuiNetworkWifi::forget(const std::string& ssid)
+{
+	if (mWaitingLoad)
+		return;
+
+	mWaitingLoad = true;
+
+	mWindow->pushGui(new GuiLoading<Result>(mWindow, _("PLEASE WAIT"),
+		[ssid](auto gui)
+		{
+			std::string error;
+			bool ok = NetworkManager::forgetWifi(ssid, &error);
+			return Result(ok, error);
+		},
+		[this, ssid](Result result)
+		{
+			finished(result.first, Utils::String::format(_("COULD NOT FORGET '%s'.").c_str(), ssid.c_str()), result.second);
+		}));
+}
+
+// After an operation: tell the owner and close on success; show the reason and stay on failure.
+void GuiNetworkWifi::finished(bool ok, const std::string& failureText, const std::string& error)
+{
+	mWaitingLoad = false;
+
+	if (ok)
+	{
+		if (mOnChanged)
+			mOnChanged();
+
+		delete this;
+		return;
+	}
+
+	mWindow->pushGui(new GuiMsgBox(mWindow, error.empty() ? failureText : failureText + "\n" + error));
+	load(NetworkManager::accessPoints(false));
+}
+
+bool GuiNetworkWifi::input(InputConfig* config, Input input)
+{
+	if (GuiComponent::input(config, input))
+		return true;
+
+	if (input.value != 0 && config->isMappedTo(BUTTON_BACK, input))
+	{
+		if (!mWaitingLoad)
+			delete this;
+
+		return true;
+	}
+
+	return false;
+}
+
+std::vector<HelpPrompt> GuiNetworkWifi::getHelpPrompts()
+{
+	std::vector<HelpPrompt> prompts = mMenu.getHelpPrompts();
+	prompts.push_back(HelpPrompt(BUTTON_BACK, _("BACK")));
+	return prompts;
+}
+
+#endif
