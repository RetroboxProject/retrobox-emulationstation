diff --git a/es-app/src/guis/GuiNetworkSettings.cpp b/es-app/src/guis/GuiNetworkSettings.cpp
new file mode 100644
index 0000000..5de74e8
--- /dev/null
+++ b/es-app/src/guis/GuiNetworkSettings.cpp
@@ -0,0 +1,157 @@
+#if defined(HAVE_NETWORKMANAGER)
+
+#include "guis/GuiNetworkSettings.h"
+
+#include "GuiLoading.h"
+#include "LocaleES.h"
+#include "Log.h"
+#include "NetworkManagerClient.h"
+#include "ThemeData.h"
+#include "Window.h"
+#include "components/SwitchComponent.h"
+#include "components/TextComponent.h"
+#include "guis/GuiMsgBox.h"
+#include "guis/GuiNetworkWifi.h"
+#include "utils/StringUtil.h"
+
+namespace
+{
+	std::shared_ptr<TextComponent> valueText(Window* window, const std::string& text)
+	{
+		auto theme = ThemeData::getMenuTheme();
+		return std::make_shared<TextComponent>(window, text, theme->Text.font, theme->Text.color, ALIGN_RIGHT);
+	}
+
+	std::string ethernetStatus(const NetworkManager::Ethernet& ethernet)
+	{
+		switch (ethernet.state)
+		{
+		case NetworkManager::Ethernet::Connected:
+			return ethernet.ip.empty() ? _("CONNECTED") : _("CONNECTED") + " - " + ethernet.ip;
+		case NetworkManager::Ethernet::Connecting:
+			return _("CONNECTING...");
+		case NetworkManager::Ethernet::Disconnected:
+			return _("DISCONNECTED");
+		case NetworkManager::Ethernet::Failed:
+			return _("CONNECTION FAILED");
+		default:
+			return _("NO CABLE");
+		}
+	}
+}
+
+GuiNetworkSettings::GuiNetworkSettings(Window* window, int autoSel) : GuiSettings(window, _("NETWORK SETTINGS").c_str())
+{
+	// Wi-Fi
+	addGroup(_("WI-FI"));
+
+	const NetworkManager::WifiStatus wifi = NetworkManager::wifiStatus();
+
+	if (!wifi.present)
+		addEntry(_("NO WI-FI ADAPTER FOUND"), false);
+	else if (wifi.hardwareBlocked)
+		addEntry(_("WI-FI IS TURNED OFF BY A HARDWARE SWITCH"), false);
+	else
+	{
+		auto enableWifi = std::make_shared<SwitchComponent>(mWindow);
+		enableWifi->setState(wifi.enabled);
+		addWithLabel(_("ENABLE WI-FI"), enableWifi, autoSel == 1);
+		enableWifi->setOnChangedCallback([this, enableWifi, wasEnabled = wifi.enabled]
+		{
+			bool enabled = enableWifi->getState();
+			if (enabled != wasEnabled)
+			{
+				std::string error;
+				if (!NetworkManager::setWifiEnabled(enabled, &error))
+				{
+					LOG(LogError) << "Wi-Fi: cannot change the radio: " << error;
+				}
+
+				reopen(1);
+			}
+		});
+
+		if (wifi.enabled)
+		{
+			addWithLabel(_("CONNECTED NETWORK"), valueText(mWindow, wifi.connectedSsid.empty() ? _("NONE") : wifi.connectedSsid));
+
+			if (!wifi.ip.empty())
+				addWithLabel(_("IP ADDRESS"), valueText(mWindow, wifi.ip));
+
+			addEntry(_("AVAILABLE NETWORKS"), true, [this, window]
+			{
+				window->pushGui(new GuiNetworkWifi(window, [this] { reopen(2); }));
+			}, "", false, autoSel == 2);
+		}
+	}
+
+	// Ethernet
+	addGroup(_("ETHERNET"));
+
+	const std::vector<NetworkManager::Ethernet> adapters = NetworkManager::ethernetDevices();
+	if (adapters.empty())
+		addEntry(_("NO ETHERNET ADAPTER FOUND"), false);
+
+	int index = 0;
+	for (const auto& ethernet : adapters)
+	{
+		const int sel = 3 + index++;
+
+		mMenu.addWithDescription(ethernet.iface, ethernetStatus(ethernet), nullptr, [this, window, ethernet, sel]
+		{
+			switch (ethernet.state)
+			{
+			case NetworkManager::Ethernet::Unavailable:
+				window->pushGui(new GuiMsgBox(window, Utils::String::format(_("NO CABLE DETECTED ON '%s'.").c_str(), ethernet.iface.c_str())));
+				break;
+
+			case NetworkManager::Ethernet::Connecting:
+				break;
+
+			case NetworkManager::Ethernet::Connected:
+				window->pushGui(new GuiMsgBox(window, Utils::String::format(_("ARE YOU SURE YOU WANT TO DISCONNECT '%s' ?").c_str(), ethernet.iface.c_str()),
+					_("YES"), [this, ethernet, sel] { runEthernet(ethernet.path, false, sel); },
+					_("NO"), nullptr));
+				break;
+
+			default:
+				runEthernet(ethernet.path, true, sel);
+				break;
+			}
+		}, "", autoSel == sel);
+	}
+}
+
+void GuiNetworkSettings::reopen(int autoSel)
+{
+	Window* parent = mWindow;
+	delete this;
+	parent->pushGui(new GuiNetworkSettings(parent, autoSel));
+}
+
+void GuiNetworkSettings::runEthernet(const std::string& devicePath, bool connect, int autoSel)
+{
+	Window* window = mWindow;
+
+	window->pushGui(new GuiLoading<std::pair<bool, std::string>>(window, _("PLEASE WAIT"),
+		[devicePath, connect](auto gui)
+		{
+			std::string error;
+			bool ok = connect ? NetworkManager::connectEthernet(devicePath, &error) : NetworkManager::disconnectEthernet(devicePath, &error);
+			if (!ok)
+			{
+				LOG(LogError) << "Ethernet: " << (connect ? "connect" : "disconnect") << " failed: " << error;
+			}
+
+			return std::make_pair(ok, error);
+		},
+		[this, window, autoSel](std::pair<bool, std::string> result)
+		{
+			if (!result.first)
+				window->pushGui(new GuiMsgBox(window, result.second.empty() ? _("THE OPERATION FAILED.") : _("THE OPERATION FAILED.") + "\n" + result.second));
+
+			reopen(autoSel);
+		}));
+}
+
+#endif
