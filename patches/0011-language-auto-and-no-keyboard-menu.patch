+// retrobox: language used when "system.language" is not set explicitly ("auto"):
+// the first usable locale of the environment (LANGUAGE, LC_ALL, LC_MESSAGES, LANG).
+static std::string detectSystemLanguage()
+{
+	for (const char* var : { "LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG" })
+	{
+		const char* value = getenv(var);
+		if (value == nullptr)
+			continue;
+
+		// LANGUAGE is a colon-separated list of preferences
+		for (const std::string& token : Utils::String::split(value, ':'))
+		{
+			std::string code = token.substr(0, token.find_first_of(".@"));
+			if (code.empty() || code == "C" || code == "POSIX")
+				continue;
+
+			return code;
+		}
+	}
+
+	return "en_US";
+}
+
+static bool isAutoLanguage(const std::string& value)
+{
+	return value.empty() || value == "auto";
+}
