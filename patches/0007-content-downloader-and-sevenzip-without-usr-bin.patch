+// Retrobox keeps its scripts in its own tree, not in /usr/bin: retrobox-core
+// exports RETROBOX_ROOTDIR (and installs to /opt/retrobox by default).
+static std::string retroboxScript(const std::string& name)
+{
+	const char* root = getenv("RETROBOX_ROOTDIR");
+	return std::string(root != nullptr && *root != '\0' ? root : "/opt/retrobox") + "/bin/" + name;
+}
+
+// The 7-Zip command line tool goes by different names: 7zr (p7zip, 7zip in Debian),
+// 7za (p7zip), 7zz (7zip in Fedora) or 7z.
+static std::string findSevenZip()
+{
+	for (const char* name : { "7zr", "7za", "7zz", "7z" })
+		if (Utils::FileSystem::exists(std::string("/usr/bin/") + name))
+			return name;
+
+	return "";
+}
