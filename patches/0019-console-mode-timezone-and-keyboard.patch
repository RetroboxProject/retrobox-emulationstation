+// retrobox: console mode (no way to quit EmulationStation: ShowExit off) offers the
+// system's time zone and keyboard layout when the machine has a system settings program
+// (retrobox-system-settings, provided by what makes it a console): Retrobox writes its path
+// into RetroboxSystemSettings before EmulationStation starts, empty when there is none
+bool ApiSystem::hasConsoleSettings()
+{
+	std::string program = Settings::getInstance()->getString("RetroboxSystemSettings");
+	return !Settings::getInstance()->getBool("ShowExit") && !program.empty() &&
+		Utils::FileSystem::exists(program);
+}
+
+std::string ApiSystem::getRetroboxSystemCommand()
+{
+	return "\"" + Settings::getInstance()->getString("RetroboxSystemSettings") + "\"";
+}
+
+std::pair<std::string, int> ApiSystem::setSystemTimezone(const std::string& tz)
+{
+	return executeScript(getRetroboxSystemCommand() + " timezone set \"" + tz + "\"", nullptr);
+}
+
+std::pair<std::string, int> ApiSystem::setSystemKeyboard(const std::string& layout, const std::string& variant)
+{
+	return executeScript(getRetroboxSystemCommand() + " keyboard set \"" + layout + "\" \"" + variant + "\"", nullptr);
+}
