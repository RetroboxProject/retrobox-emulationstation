+std::vector<std::string> ApiSystem::getSystemLanguages()
+{
+	std::vector<std::string> languages;
+	for (auto line : executeEnumerationScript(getRetroboxSystemCommand() + " locale list"))
+	{
+		auto code = Utils::String::trim(line.substr(0, line.find(' ')));
+		if (!code.empty())
+			languages.push_back(code);
+	}
+	return languages;
+}
+
+std::string ApiSystem::getSystemLanguage()
+{
+	for (auto line : executeEnumerationScript(getRetroboxSystemCommand() + " locale get"))
+	{
+		auto code = Utils::String::trim(line);
+		if (!code.empty())
+			return code;
+	}
+	return "en_US";
+}
+
+std::pair<std::string, int> ApiSystem::setSystemLanguage(const std::string& language)
+{
+	return executeScript(getRetroboxSystemCommand() + " locale set \"" + language + "\"", nullptr);
+}
