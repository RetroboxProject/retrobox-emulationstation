 	return executeScript(getRetroboxSystemCommand() + " locale set \"" + language + "\"", nullptr);
 }
 
+// retrobox: XDP's DNS over TLS (dns.xdp.es), a drop-in of systemd-resolved that
+// retrobox-xdp-dns (retrobox-system-settings) writes and removes; NetworkManager is
+// left alone. status prints "on" or "off" and exits 0; a machine without
+// retrobox-xdp-dns in the PATH makes the shell exit 127, and the toggle is not offered.
+int ApiSystem::getXdpDnsState()
+{
+	auto status = executeScript("retrobox-xdp-dns status 2>/dev/null", nullptr);
+	if (status.second != 0)
+		return -1;
+
+	return Utils::String::trim(status.first) == "on" ? 1 : 0;
+}
+
+std::pair<std::string, int> ApiSystem::setXdpDns(bool enable)
+{
+	// the last output line is the reason when it fails (the scripts' convention)
+	return executeScript(std::string("retrobox-xdp-dns ") + (enable ? "on" : "off") + " 2>&1", nullptr);
+}
