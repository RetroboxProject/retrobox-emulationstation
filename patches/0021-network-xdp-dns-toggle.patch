+void GuiNetworkSettings::runXdpDns(bool enable, int autoSel)
+{
+	Window* window = mWindow;
+
+	window->pushGui(new GuiLoading<std::pair<std::string, int>>(window, _("PLEASE WAIT"),
+		[enable](auto gui)
+		{
+			return ApiSystem::getInstance()->setXdpDns(enable);
+		},
+		[this, window, autoSel](std::pair<std::string, int> result)
+		{
+			if (result.second != 0)
+			{
+				LOG(LogError) << "XDP DNS: retrobox-xdp-dns " << (result.second == 127 ? "is gone" : "failed") << ": " << result.first;
+				window->pushGui(new GuiMsgBox(window, result.first.empty() ? _("THE OPERATION FAILED.") : _("THE OPERATION FAILED.") + "\n" + result.first));
+			}
+
+			reopen(autoSel);
+		}));
+}
